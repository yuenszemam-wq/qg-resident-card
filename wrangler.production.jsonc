{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qg-resident-card-prod",
  "account_id": "dd7c91f8458fd997ec5e349c1a4ec41a",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "MIGRATION_LOCKED": "true",
    "SHEET_ID": "1LOLGOskQi2lpahGrCdcpo8E4b3d2s78pA6eairtpHb4",
    "DRIVE_FOLDER_ID": "1SE2spJD5yj_WNKBBKJCzXo6e3eSjSvn19h2Ibb6X_FTk-LgVpIG7pso141ZG1jN1oEbRXITw"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "qg-resident-card-prod-db-20261120",
    "database_id": "dc4b7076-3c75-436f-8d8d-bb1ee8c3ef3f",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "qg-resident-card-prod-media-20261120" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.2, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
