{
  // 舊網址轉送入口：宣傳製作中心已併入 QG 異世界居民報更系統（qg-shift-system 的 /card/）。
  // 原 D1（qg-resident-card-db）及 R2（qg-resident-card-media）不再綁定，保留作備份，未刪除。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qg-resident-card",
  "main": "worker/gateway.js",
  "compatibility_date": "2026-10-15",
  // 轉送到另一個 workers.dev 網址時經公開網絡
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.2 }
}
